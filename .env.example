# Versand des Anfrageformulars (/api/anfrage) über das Firmenpostfach info@cbf24.de.
# In Vercel unter Project Settings → Environment Variables setzen, lokal in .env.local.
# Kommentare stehen bewusst in eigenen Zeilen: Nur den Wert nach dem "=" in Vercel eintragen.

# SMTP-Server des E-Mail-Anbieters (cbf24.de liegt bei der Telekom, vermutlich securesmtp.t-online.de)
SMTP_HOST=
# 465 = SSL/TLS (Standard), 587 = STARTTLS
SMTP_PORT=465
# Benutzername, meist die volle Adresse: info@cbf24.de
SMTP_USER=
# Passwort des Postfachs (in Vercel als "Sensitive" markieren)
SMTP_PASS=

# Optional – Empfänger der Anfragen (Standard: info@cbf24.de)
MAIL_TO=
# Optional – Absenderadresse (Standard: SMTP_USER)
MAIL_FROM=

# Testphase auf einer Subdomain (z. B. neu.cbf24.de): 1 = nicht bei Google indexieren.
# Beim Umzug auf www.cbf24.de löschen und neu deployen.
NOINDEX=

# Voiceflow-Chat: Projekt-ID aus Voiceflow → Integration → Web Chat → Installation (verify: { projectID: '…' }).
# Leer lassen = Chat-Button zeigt nur WhatsApp, Telefon und Anfrageformular.
NEXT_PUBLIC_VOICEFLOW_PROJECT_ID=
