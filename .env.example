# Versand des Anfrageformulars (/api/anfrage) über das Firmenpostfach.
# In Vercel unter Project Settings → Environment Variables setzen, lokal in .env.local.
# Zugangsdaten gibt es beim E-Mail-Anbieter von info@cbf24.de (SMTP-Server, Port, Benutzer, Passwort).
SMTP_HOST=
SMTP_PORT=465          # 465 = SSL/TLS, 587 = STARTTLS
SMTP_USER=             # meist die volle Adresse, z. B. info@cbf24.de
SMTP_PASS=
# Optional:
MAIL_TO=info@cbf24.de  # Empfänger der Anfragen (Standard: info@cbf24.de)
MAIL_FROM=             # Absenderadresse (Standard: SMTP_USER)
